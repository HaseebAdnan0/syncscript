# SyncScript Production Environment Variables
# Copy this to .env on the VPS and fill in the values

# =============================================================================
# Database
# =============================================================================
DB_NAME=syncscript_db
DB_USER=syncscript
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# =============================================================================
# Django
# =============================================================================
SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
DEBUG=False
ALLOWED_HOSTS=syncscript.haseebadnan.com
CORS_ALLOWED_ORIGINS=https://syncscript.haseebadnan.com
CSRF_TRUSTED_ORIGINS=https://syncscript.haseebadnan.com
SITE_URL=https://syncscript.haseebadnan.com

# =============================================================================
# Email (Hostinger SMTP)
# =============================================================================
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=noreply@yourdomain.com
EMAIL_HOST_PASSWORD=YOUR_EMAIL_PASSWORD
DEFAULT_FROM_EMAIL=SyncScript <noreply@yourdomain.com>

# =============================================================================
# OAuth Providers
# =============================================================================
# Google OAuth (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# =============================================================================
# Cloudflare R2 Storage (S3-compatible)
# =============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=syncscript-files
AWS_S3_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
AWS_S3_REGION_NAME=auto

# =============================================================================
# AI Services
# =============================================================================
ANTHROPIC_API_KEY=
AI_DAILY_LIMIT=20

# =============================================================================
# Docker / Deployment
# =============================================================================
IMAGE_TAG=latest

# Host ports (for debug access only - nginx uses Docker network)
POSTGRES_PORT=5436
BACKEND_PORT=8005
FRONTEND_PORT=3005
REDIS_PORT=6380
