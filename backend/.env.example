# Django Settings
# SECURITY WARNING: Generate a new secret key for production using:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-change-in-production

# Debug mode - set to False in production
DEBUG=True

# Allowed hosts - comma-separated list of domains
ALLOWED_HOSTS=localhost,127.0.0.1

# Site URL for email links (no trailing slash)
SITE_URL=http://localhost:8000

# Database Configuration
# PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/syncscript

# Redis Configuration
# Used for caching and rate limiting
REDIS_URL=redis://localhost:6379/0

# Email Configuration (SMTP)
# Email backend - use django.core.mail.backends.smtp.EmailBackend for production
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# SMTP server settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# SMTP authentication
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Default sender email
DEFAULT_FROM_EMAIL=noreply@syncscript.com

# JWT Configuration
# Access token lifetime in minutes (default: 15 minutes)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15

# Refresh token lifetime in days (default: 7 days)
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# AWS S3 / Cloudflare R2 Storage
# For PDF file uploads
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_STORAGE_BUCKET_NAME=syncscript-uploads
AWS_S3_REGION_NAME=auto
AWS_S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com

# Pusher Configuration (optional)
# For real-time notifications
PUSHER_APP_ID=your-pusher-app-id
PUSHER_KEY=your-pusher-key
PUSHER_SECRET=your-pusher-secret
PUSHER_CLUSTER=us2

# Twilio Configuration (optional)
# For SMS notifications
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# CORS Settings
# Comma-separated list of allowed origins for frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
# Enable rate limiting (True/False)
RATELIMIT_ENABLE=True

# OAuth Configuration
# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
